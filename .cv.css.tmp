
/* ---------- CV-Upload ---------- */
.unsichtbar { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.cv-karte {
  position: relative;
  margin: 18px 0 8px;
  padding: 18px 16px 14px;
  border: 2px dashed #c7d2fe;
  border-radius: var(--radius);
  background: var(--akzent-hell);
}
.cv-titel { display: block; font-size: 1.05rem; }
.cv-karte .hinweis { margin: 4px 0 12px; }
.cv-knopf { display: flex; align-items: center; justify-content: center; text-align: center; cursor: pointer; background: var(--flaeche); }
.cv-karte .erfolg, .cv-karte .fehler { margin: 12px 0 4px; }
.cv-kopf { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin: 12px 0 4px; }
.cv-kopf .hinweis { margin: 0; }
.cv-karte .wortliste .wort-zeile { background: var(--flaeche); }
.cv-karte .cv { margin-top: 12px; }
.cv-karte .wort-zeile { flex-wrap: nowrap; }
.mini-icon { width: 44px; min-height: 40px; padding: 0; font-size: 1rem; flex: none; }
